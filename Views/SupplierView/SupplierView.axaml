<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SistemaDistribuidora.ViewModels"
             xmlns:dto="using:SistemaDistribuidora.DTOs"
             x:Class="SistemaDistribuidora.Views.SupplierView"
             x:DataType="vm:SupplierViewModel">

	<Design.DataContext>
		<vm:SupplierViewModel/>
	</Design.DataContext>

	<Grid ColumnDefinitions="220,*">

		<!-- BARRA LATERAL NAVEGACIÓN -->
		<Border Grid.Column="0" Background="#1E1E2E" Padding="0">
			<DockPanel>
				<!-- Cabecera usuario -->
				<Border DockPanel.Dock="Top" Background="#2A2A3E" Padding="20 35">
					<StackPanel Spacing="4">
						<Border Width="48" Height="48" CornerRadius="24" Background="#7C3AED" HorizontalAlignment="Left">
							<TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<TextBlock Text="{Binding WelcomeMessage}" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0 6 0 0"/>
						<Border Background="#7C3AED" CornerRadius="4" Padding="6 2" HorizontalAlignment="Left">
							<TextBlock Text="{Binding UserRole}" Foreground="White" FontSize="11"/>
						</Border>
					</StackPanel>
				</Border>

				<!-- Boton regresar al menu -->
				<Button DockPanel.Dock="Bottom" Command="{Binding GoToMainMenuCommand}" Background="Transparent" Foreground="#EF4444" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 14" Margin="0" CornerRadius="0">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="🚪" FontSize="16"/>
						<TextBlock Text="Regresar Menu Principal" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<Separator DockPanel.Dock="Bottom" Background="#2A2A3E" Height="1"/>

				<!-- Menú de operaciones -->
				<ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="0 8" Spacing="2">
						<TextBlock Text="OPERACIONES" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="20 12 0 4" LetterSpacing="1.5"/>

						<Button Command="{Binding ShowCreateSupplierPanelCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 10">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="🏭" FontSize="16"/>
								<TextBlock Text="Ingresar Nuevo Proveedor" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding ShowUpdateSupplierPanelCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 10">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="🔄" FontSize="16"/>
								<TextBlock Text="Actualizar Proveedor" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding ShowSupplierListPanelCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 10">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="📋" FontSize="16"/>
								<TextBlock Text="Mostrar Proveedores" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<!-- Admin only -->
						<StackPanel IsVisible="{Binding IsAdmin}">
							<TextBlock Text="ADMINISTRACIÓN" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="20 16 0 4" LetterSpacing="1.5"/>

							<Button Command="{Binding ShowReportsPanelCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 10">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<TextBlock Text="📄" FontSize="16"/>
									<TextBlock Text="Reportes" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<Button Command="{Binding ShowDeleteSupplierPanelCommand}" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20 10">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<TextBlock Text="🗑️" FontSize="16"/>
									<TextBlock Text="Eliminar Proveedor" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<!-- CONTENIDO DINÁMICO PANELES -->
		<Grid Grid.Column="1">

			<Grid Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

				<!-- BIENVENIDA CENTRADA EN PANTALLA -->
				<Grid IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" VerticalAlignment="Center">
					<StackPanel Spacing="12">
						<TextBlock Text="🏭" FontSize="64" HorizontalAlignment="Center"/>
						<TextBlock Text="Gestión de Proveedores" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
						<TextBlock Text="Selecciona una opción del menú para comenzar" FontSize="14" Opacity="0.5" HorizontalAlignment="Center"/>
					</StackPanel>
				</Grid>

				<!-- PANEL CREAR PROVEEDOR -->
				<Border IsVisible="{Binding ShowCrearProveedor}" Padding="40">
					<ScrollViewer>
						<StackPanel MaxWidth="560" Spacing="16">
							<TextBlock Text="Ingresar Proveedor" FontSize="22" FontWeight="Bold" Margin="0 0 0 8"/>

							<StackPanel Spacing="4">
								<TextBlock Text="Nombre completo / Razón Social" FontSize="13" Opacity="0.7"/>
								<TextBox Text="{Binding CreateFullName}" Watermark="Nombre comercial o legal del proveedor"/>
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="Cédula / RUC" FontSize="13" Opacity="0.7"/>
								<TextBox Text="{Binding CreateIdentity}" Watermark="Ej: 001-010190-0001A / J0310000..."/>
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="Teléfono" FontSize="13" Opacity="0.7"/>
								<TextBox Text="{Binding CreatePhone}" Watermark="Ej: 8888-0000"/>
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="Dirección" FontSize="13" Opacity="0.7"/>
								<TextBox Text="{Binding CreateAddress}" Watermark="Dirección física de operaciones" AcceptsReturn="True" Height="80"/>
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="Tipo de persona" FontSize="13" Opacity="0.7"/>
								<ComboBox ItemsSource="{Binding PersonTypeOptions}" SelectedItem="{Binding SelectedPersonType}" HorizontalAlignment="Stretch" />
							</StackPanel>

							<TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="13" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Text="{Binding SuccessMessage}" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

							<Button Content="Guardar Proveedor" Command="{Binding SaveSupplierCommand}" IsEnabled="{Binding !IsLoading}" Background="#7C3AED" Foreground="White" HorizontalAlignment="Left" Padding="20 10" CornerRadius="6"/>
						</StackPanel>
					</ScrollViewer>
				</Border>

				<!-- PANEL ACTUALIZAR PROVEEDOR -->
				<Border IsVisible="{Binding ShowActualizarProveedor}" Padding="40">
					<ScrollViewer>
						<StackPanel MaxWidth="560" Spacing="16">
							<TextBlock Text="Actualizar Proveedor" FontSize="22" FontWeight="Bold" Margin="0 0 0 8"/>

							<StackPanel Spacing="4">
								<TextBlock Text="Buscar proveedor" FontSize="13" Opacity="0.7"/>
								<TextBox Text="{Binding UpdateSearch}" Watermark="Escribe el nombre del proveedor..."/>
							</StackPanel>

							<Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="6" IsVisible="{Binding FilteredSupplierForUpdate.Count}">
								<ItemsControl ItemsSource="{Binding FilteredSupplierForUpdate}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="dto:SupplierListDto">
											<Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12 8" Command="{Binding $parent[UserControl].((vm:SupplierViewModel)DataContext).SelectSupplierToUpdateCommand}" CommandParameter="{Binding}">
												<TextBlock Text="{Binding FullName}"/>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<StackPanel Spacing="16" IsVisible="{Binding SelectedSupplierForUpdate, Converter={x:Static ObjectConverters.IsNotNull}}">
								<StackPanel Spacing="4">
									<TextBlock Text="Nombre completo" FontSize="13" Opacity="0.7"/>
									<TextBox Text="{Binding UpdateFullName}"/>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="Cédula / Identidad" FontSize="13" Opacity="0.7"/>
									<TextBox Text="{Binding UpdateIdentity}"/>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="Teléfono" FontSize="13" Opacity="0.7"/>
									<TextBox Text="{Binding UpdatePhone}"/>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="Dirección" FontSize="13" Opacity="0.7"/>
									<TextBox Text="{Binding UpdateAddress}" AcceptsReturn="True" Height="80"/>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="Tipo de persona" FontSize="13" Opacity="0.7"/>
									<ComboBox ItemsSource="{Binding PersonTypeOptions}" SelectedItem="{Binding SelectedPersonType}" HorizontalAlignment="Stretch" />
								</StackPanel>

								<TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
								<TextBlock Text="{Binding SuccessMessage}" Foreground="#10B981" FontWeight="SemiBold" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

								<Button Content="Actualizar Proveedor" Command="{Binding UpdateSupplierCommand}" IsEnabled="{Binding !IsLoading}" Background="#7C3AED" Foreground="White" HorizontalAlignment="Left" Padding="20 10" CornerRadius="6"/>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</Border>

				<!-- PANEL MOSTRAR LISTA -->
				<Border IsVisible="{Binding ShowListaProveedores}" Padding="40">
					<StackPanel Spacing="16">
						<TextBlock Text="Proveedores Registrados" FontSize="22" FontWeight="Bold"/>
						<TextBlock Text="Cargando..." IsVisible="{Binding IsLoading}" Opacity="0.6"/>

						<DataGrid ItemsSource="{Binding SupplierDetail}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="*"/>
								<DataGridTextColumn Header="Identidad / RUC" Binding="{Binding IdentityCard}" Width="*"/>
								<DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="*"/>
								<DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="2*"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>

				<!-- PANEL ELIMINAR PROVEEDOR (PROXIMAMENTE) -->
				<Border IsVisible="{Binding ShowEliminarProveedor}" Padding="40">
					<StackPanel MaxWidth="560" Spacing="16">
						<TextBlock Text="Eliminar Proveedor" FontSize="22" FontWeight="Bold" Margin="0 0 0 8"/>
						<TextBlock Text="Próximamente..." Opacity="0.6"/>
					</StackPanel>
				</Border>

				<!-- PANEL REPORTES -->
				<Border IsVisible="{Binding ShowReportes}" Padding="40">
					<StackPanel Spacing="16">
						<TextBlock Text="Reportes de Proveedores" FontSize="22" FontWeight="Bold"/>
						<TextBlock Text="Próximamente..." Opacity="0.6"/>
					</StackPanel>
				</Border>

			</Grid>
			</Grid>
		</Grid>
</UserControl>
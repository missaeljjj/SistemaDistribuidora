<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SistemaDistribuidora.ViewModels"
        xmlns:views="using:SistemaDistribuidora.Views"
        x:Class="SistemaDistribuidora.Views.MainWindow"
        Title="Distribuidora GO - Login"
        Width="450" Height="550"
        WindowStartupLocation="CenterScreen"
		Icon="/Assets/DistribuidoraGO.ico"
		WindowState="Maximized"
        x:DataType="vm:LoginViewModel">

	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vm:LoginViewModel}">
			<views:LoginView/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
			<views:MainMenuView/>
		</DataTemplate>
	</Window.DataTemplates>

	<ContentControl Content="{Binding}" />

</Window>